---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProposalSection from '../components/ProposalSection.astro';
import ProposalPhoto from '../components/ProposalPhoto.astro';
import { getProposal, groups } from '../lib/proposal';
import '../styles/proposal.css';
const sections = await getProposal();
const cover = sections[0]!;
---
<BaseLayout title="홍성 관광객 유치 제안 A안·B안" description="미식·해안·체험을 잇는 홍성 체류 프로그램. 궁리 1박 코스와 월별 브랜드 모임을 검토하는 v02 내부 제안서." activePage="proposal" customHeading>
  <h1 class="sr-only">홍성 관광객 유치 제안 A안·B안</h1>
  <div class="proposal-reader" id="proposal-reader">
    <nav class="proposal-navigation" aria-label="제안서 내부 목차">
      <div class="container toc-inner"><a class="toc-cover" href="#top">표지</a><ol>{groups.map((group, index) => <li><a href={`#${group.id}`} data-start-page={group.from}><span class="toc-number">{String(index + 1).padStart(2, '0')}</span>{group.label}</a></li>)}</ol></div>
    </nav>
    <div class="reader-surface">
      <div class="reader-stage" id="reader-stage" role="region" aria-label="제안서 페이지" tabindex="-1">
        {sections.map(section => <div class="proposal-page container" data-page={section.number} data-page-label={section.category} data-theme={section.number >= 16 ? 'dark' : undefined} hidden={section.number !== 1}>
          {groups.filter(group => group.from === section.number).map(group => <span id={group.id} class="page-anchor" aria-hidden="true" />)}
          {section.number === 1 ? <section id="top" class="proposal-hero" data-source-page="1" aria-labelledby="proposal-title">
            <div class="hero-grid">
              <div class="hero-copy">
                <p class="document-meta"><span class="review-mark">내부 검토본</span><span>제안 v02 · OCT 2026</span></p>
                <p class="hero-eyebrow">홍성 관광객 유치 제안 A안·B안</p>
                <h2 id="proposal-title" class="display-title" lang="en"><span>BEAUTIFUL</span>{' '}<span>STAY</span>{' '}<span>HONGSEONG</span></h2>
                <div class="hero-description prose" set:html={cover.html} />
                <div class="hero-actions"><a class="primary-link" href="#plan-a">A안 살펴보기 <span aria-hidden="true">↗</span></a><a class="text-link" href="#plan-b">B안 살펴보기 <span aria-hidden="true">↗</span></a></div>
              </div>
              {cover.photo && <ProposalPhoto photo={cover.photo} eager />}
            </div>
            <div class="source-notes cover-notes" set:html={cover.notes} />
          </section> : <ProposalSection section={section} />}
        </div>)}
      </div>
      <nav class="reader-controls" aria-label="페이지 넘기기">
        <div class="container reader-controls-inner">
          <button class="page-arrow" id="previous-page" type="button" aria-label="이전 페이지" aria-controls="reader-stage" disabled><span aria-hidden="true">←</span><span class="arrow-label">이전</span></button>
          <div class="reader-position">
            <label class="sr-only" for="page-select">페이지 선택</label>
            <select id="page-select" aria-controls="reader-stage">{sections.map(section => <option value={section.number}>{String(section.number).padStart(2, '0')}. {section.category}</option>)}</select>
            <span id="page-counter" aria-live="polite" aria-atomic="true">1 / {sections.length}</span>
          </div>
          <button class="page-arrow" id="next-page" type="button" aria-label="다음 페이지" aria-controls="reader-stage"><span class="arrow-label">다음</span><span aria-hidden="true">→</span></button>
        </div>
      </nav>
    </div>
  </div>
  <noscript>
    <style>body:has(.proposal-reader){height:auto;overflow:auto}.proposal-reader,.reader-surface{display:block}.reader-stage{overflow:visible}.proposal-page[hidden]{display:block}.proposal-page{padding-block:2rem}.reader-controls{display:none}</style>
    <p class="container">페이지 넘기기를 사용하려면 JavaScript를 켜 주세요. 현재는 모든 페이지를 이어서 표시합니다.</p>
  </noscript>
</BaseLayout>
<script>
  import '../scripts/proposal-reader';
</script>
