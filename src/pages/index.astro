---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProposalSection from '../components/ProposalSection.astro';
import ProposalPhoto from '../components/ProposalPhoto.astro';
import { getProposal, groups } from '../lib/proposal';
import deck from '../content/proposal-slides.json';
import '../styles/proposal.css';
const sections = await getProposal();
const cover = sections[0]!;
const slides = deck.slides.map((slide, index) => ({ ...slide, section: sections[index],
  label: sections[index]?.category ?? '클로징',
  title: sections[index]?.title.replace(/<[^>]*>/g, '') ?? 'THANK YOU' }));
---
<BaseLayout title="홍성 관광객 유치 제안 A안·B안" description="최신 제안 PPT v03과 같은 30쪽 슬라이드. 궁리 1박 코스와 월별 브랜드 모임의 내부 검토본." activePage="proposal" customHeading>
  <h1 class="sr-only">홍성 관광객 유치 제안 A안·B안</h1>
  <div class="proposal-reader" id="proposal-reader">
    <nav class="proposal-navigation" aria-label="제안서 내부 목차">
      <div class="container toc-inner"><a class="toc-cover" href="#top">표지</a><ol>{groups.map((group, index) => <li><a href={'#' + group.id} data-start-page={group.from}><span class="toc-number">{String(index + 1).padStart(2, '0')}</span>{group.label}</a></li>)}</ol></div>
    </nav>
    <div class="reader-surface">
      <div class="reader-stage" id="reader-stage" role="region" aria-label="제안서 슬라이드" aria-describedby="reader-keyboard-help" tabindex="-1">
        {slides.map(({number, src, label, title, section}) => <div class="proposal-page" data-page={number} data-page-label={label} hidden={number !== 1}>
          {groups.filter(group => group.from === number).map(group => <span id={group.id} class="page-anchor" aria-hidden="true" />)}
          <img class="slide-artwork" src={src} width={deck.width} height={deck.height}
            alt={number + ' / ' + slides.length + ' · ' + label + ' · ' + title} loading={number === 1 ? 'eager' : 'lazy'}
            fetchpriority={number === 1 ? 'high' : 'auto'} decoding="async" />
          <div class="slide-text container" data-theme={number === 1 || number >= 16 ? 'dark' : undefined} hidden>
            {number === 1 ? <section id="top" class="proposal-hero" data-source-page="1" aria-labelledby="proposal-title">
              <h2 id="proposal-title" class="display-title" lang="en">BEAUTIFUL STAY HONGSEONG</h2>
              <div class="prose" set:html={cover.html} />
              {cover.photo && <ProposalPhoto photo={cover.photo} />}
              <div class="source-notes" set:html={cover.notes} />
            </section> : section ? <ProposalSection section={section} total={slides.length} /> :
              <section id="page-30" aria-labelledby="closing-title"><h2 id="closing-title" class="display-title" lang="en">THANK YOU</h2><p>홍성 관광객 유치 제안 · 클로징</p></section>}
          </div>
        </div>)}
      </div>
      <nav class="reader-controls" aria-label="슬라이드 조작">
        <div class="container reader-controls-inner">
          <div class="reader-position">
            <span id="page-counter" aria-live="polite" aria-atomic="true">1 / {slides.length}</span>
            <button class="reader-text-toggle" id="text-toggle" type="button" aria-pressed="false" aria-controls="reader-stage">본문·출처</button>
          </div>
          <div class="reader-actions">
            <button class="reader-fullscreen" id="fullscreen-toggle" type="button" aria-pressed="false" aria-label="전체 화면 시작" title="전체 화면 시작 (F)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg><span class="fullscreen-label">전체 화면</span></button>
            <div class="page-arrows">
              <button class="page-arrow" id="previous-page" type="button" aria-label="이전 슬라이드" aria-controls="reader-stage" title="이전 슬라이드 (←)" disabled><span aria-hidden="true">←</span><span class="arrow-label">이전</span></button>
              <button class="page-arrow" id="next-page" type="button" aria-label="다음 슬라이드" aria-controls="reader-stage" title="다음 슬라이드 (→)"><span class="arrow-label">다음</span><span aria-hidden="true">→</span></button>
            </div>
          </div>
        </div>
      </nav>
      <p id="reader-status" class="reader-status" role="status" hidden></p>
    </div>
    <p id="reader-keyboard-help" class="sr-only">좌우 방향키로 이전·다음 슬라이드 이동. Home은 처음, End는 마지막. F는 전체 화면, Esc는 전체 화면 종료. 본문·출처 버튼으로 텍스트와 출처 열람.</p>
  </div>
  <noscript><style>body:has(.proposal-reader){height:auto;overflow:auto}.proposal-reader,.reader-surface,.reader-stage{display:block;overflow:visible}.proposal-page[hidden],.slide-text[hidden]{display:block!important}.proposal-page{height:auto;padding-block:2rem;container-type:normal;display:block}.slide-artwork{width:80%;height:auto;margin-inline:auto}.reader-controls{display:none}</style><p class="container">페이지 넘기기를 사용하려면 JavaScript를 켜 주세요. 현재는 모든 슬라이드와 본문을 이어서 표시합니다.</p></noscript>
</BaseLayout>
<script>
  import '../scripts/proposal-reader';
</script>
