---
import BaseLayout from '../layouts/BaseLayout.astro';
import IdeaCard from '../components/IdeaCard.astro';
import IdeaPhoto from '../components/IdeaPhoto.astro';
import IdeaSection from '../components/IdeaSection.astro';
import IdeaSectionNav from '../components/IdeaSectionNav.astro';
import { ideas, policySection, PASS_HREF, IDEA_PRINCIPLE } from '../content/ideas';
import '../styles/ideas.css';
const programs = ideas.filter(idea => idea.kind !== 'pass');
const pass = ideas.find(idea => idea.kind === 'pass')!;
const sections = [
  { id: 'introduction', label: '기획 의도' },
  { id: 'flow', label: '참여 흐름' },
  { id: 'programs', label: 'A·B 프로그램' },
  { id: 'stay-pass', label: '홍성 패스' },
  { id: policySection.id, label: '정책 연결' },
];
---
<BaseLayout title="아이디어" description="궁리 체험 코스와 홍성 관광 랠리, 숙박 선택 이후의 공통 홍성 패스. 홍성의 기존 풍경과 장소를 잇는 기획 검토안." activePage="ideas" customHeading mainClass="ideas-main">
  <div class="container ideas-shell">
    <IdeaSectionNav sections={sections} />
    <div class="ideas-index" data-ideas-list data-section-content>
    <header id="introduction" class="ideas-cover">
      <div>
        <p class="idea-eyebrow">홍성 아이디어 · 기획 검토안</p>
        <h1>{IDEA_PRINCIPLE.split(', ').map((phrase, index) => <span>{phrase}{index < 2 ? ', ' : ''}</span>)}</h1>
        <p class="idea-lead">홍성의 바다와 항구, 천수만 노을을 경험하는 여행 제안.</p>
        <p class="ideas-intro">자연을 보존하며 기존 장소의 매력을 전하고, 어촌계·상권과 함께 다시 찾고 머물 이유 마련.</p>
      </div>
      <IdeaPhoto photoKey="gungri_new_5.jpg" eager />
    </header>
    <section id="flow" class="ideas-flow" aria-labelledby="flow-title">
      <div class="ideas-section-heading"><h2 id="flow-title">프로그램 참여 흐름</h2></div>
      <ol class="ideas-flow-track">
        <li class="ideas-flow-step">
          <span class="ideas-flow-number" aria-hidden="true">01</span>
          <div>
            <h3>두 프로그램을 즐기고</h3>
            <ul class="ideas-flow-options">{programs.map(idea => <li><span>{idea.label}</span><a class="ideas-flow-link" href={`/ideas/${idea.slug}/`} data-idea-detail-link={`flow-${idea.slug}`}>{idea.title}</a></li>)}</ul>
          </div>
          <svg class="ideas-flow-arrow" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h16m-7-7 7 7-7 7" /></svg>
        </li>
        <li class="ideas-flow-step">
          <span class="ideas-flow-number" aria-hidden="true">02</span>
          <div>
            <h3>숙박 여부 선택</h3>
            <p>하루 일정으로 마치거나,<br />홍성에서 하룻밤 더 머무는 선택.</p>
          </div>
          <svg class="ideas-flow-arrow" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 12h16m-7-7 7 7-7 7" /></svg>
        </li>
        <li class="ideas-flow-step">
          <span class="ideas-flow-number" aria-hidden="true">03</span>
          <div>
            <h3>숙박을 선택하면 홍성 패스로</h3>
            <p>별밤 프로그램·현장 굿즈와<br />여행 후 환급 연계 검토.</p>
            <a class="ideas-flow-link ideas-flow-detail" href={PASS_HREF} data-idea-detail-link={`flow-${pass.slug}`}>{pass.linkLabel}</a>
          </div>
        </li>
      </ol>
    </section>
    <section id="programs" class="ideas-programs" aria-labelledby="programs-title">
      <div class="ideas-section-heading"><h2 id="programs-title">홍성을 즐기는 두 가지 프로그램</h2></div>
      <ul class="idea-grid">{programs.map(idea => <li><IdeaCard idea={idea} /></li>)}</ul>
    </section>
    <section id="stay-pass" class="ideas-pass" aria-labelledby="pass-title">
      <div class="ideas-section-heading"><h2 id="pass-title">하룻밤 더 머물고 싶다면</h2></div>
      <div class="ideas-pass-content">
        <IdeaPhoto photoKey={pass.photo} />
        <div class="ideas-pass-copy">
          <p class="idea-card-meta">숙박 선택 이후의 공통 프로그램</p>
          <h3>{pass.title}</h3>
          <p>A안 체험 코스나 B안 관광 랠리를 즐긴 뒤 홍성에서 숙박을 선택한 사람을 위한 프로그램. 다른 홍성 행사와의 연계도 검토.</p>
          <p>별밤 프로그램과 현장 굿즈, 여행 후 지역상품권 환급 연계로 홍성의 밤과 지역 소비를 잇는 구상.</p>
          <a class="idea-button" href={PASS_HREF} data-idea-detail-link={`card-${pass.slug}`}>{pass.linkLabel}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
    <IdeaSection section={policySection} />
    </div>
  </div>
</BaseLayout>
<script>
  import '../scripts/ideas-navigation';
  import '../scripts/ideas-sections';
</script>
