---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdeaPhoto from '../../components/IdeaPhoto.astro';
import IdeaSection from '../../components/IdeaSection.astro';
import IdeaSectionNav from '../../components/IdeaSectionNav.astro';
import { ideas } from '../../content/ideas';
import '../../styles/ideas.css';

export const getStaticPaths = (() => ideas.map(idea => ({ params: { slug: idea.slug }, props: { idea } }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { idea } = Astro.props;
const related = ideas.filter(other => other.slug !== idea.slug);
const sections = idea.sections.map(section => ({ id: section.id, label: section.title }));
---
<BaseLayout title={idea.title} description={idea.summary} activePage="ideas" customHeading mainClass="ideas-main">
  <div class="container ideas-shell">
    <IdeaSectionNav sections={sections} title="페이지 목차" label={`${idea.title} 내부 목차`} detail />
  <article class="idea-detail" data-section-content>
    <a class="idea-back" href="/" data-ideas-return><span aria-hidden="true">←</span> 아이디어 목록으로</a>
    <header class="idea-hero">
      <div class="idea-hero-copy">
        <div class="idea-eyebrow"><span class="idea-badge">{idea.label}</span><span>{idea.role}</span></div>
        <h1>{idea.title}</h1>
        <p class="idea-lead">{idea.summary}</p>
      </div>
      <IdeaPhoto photoKey={idea.photo} eager />
    </header>
    <div class="idea-detail-grid">
      <div class="idea-story">{idea.sections.map(section => <IdeaSection section={section} />)}</div>
      <aside class="idea-sidebar" aria-label="아이디어 정보">
        <section class="idea-facts" aria-labelledby="idea-facts-title">
          <h2 id="idea-facts-title">아이디어 개요</h2>
          <dl>{idea.facts.map(fact => <div><dt>{fact.title}</dt><dd>{fact.text}</dd></div>)}</dl>
        </section>
      </aside>
    </div>
    <nav class="idea-related" aria-label="연결된 아이디어">
      <h2>{idea.kind === 'pass' ? '홍성 패스로 이어지는 프로그램' : '함께 연결되는 아이디어'}</h2>
      <ul>{related.map(other => <li><p class="idea-related-category">{other.label} · {other.role}</p><h3>{other.title}</h3><a class="idea-button" href={`/ideas/${other.slug}/`}>{other.linkLabel}<span aria-hidden="true">→</span></a></li>)}</ul>
      <a class="idea-back" href="/" data-ideas-return>아이디어 목록으로</a>
    </nav>
  </article>
  </div>
</BaseLayout>
<script>
  import '../../scripts/ideas-navigation';
  import '../../scripts/ideas-sections';
</script>
