---
import ProposalPhoto from './ProposalPhoto.astro';
import type { ProposalSection } from '../lib/proposal';
interface Props { section: ProposalSection }
const { section } = Astro.props;
---
<article id={section.id} class:list={['proposal-article', { 'has-photo': section.photo, 'plan-divider': [4, 16].includes(section.number) }]}
  data-source-page={section.number} aria-labelledby={`${section.id}-title`}>
  <header class="article-heading">
    <p class="article-label"><span class="display-title" lang="en">{section.english}</span><span>{section.category}</span><span class="source-page">{String(section.number).padStart(2, '0')} / 29</span></p>
    <h2 id={`${section.id}-title`} set:html={section.title} />
  </header>
  <div class="article-main">
    <div class="prose" set:html={section.html} />
    {section.photo && <ProposalPhoto photo={section.photo} />}
  </div>
  <div class="source-notes" set:html={section.notes} />
</article>
