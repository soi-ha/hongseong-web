---
import { SITE_NAME, SITE_PAGES, SITE_ICONS, type SitePage } from '../config/site';

interface Props {
  activePage: SitePage;
}

const { activePage } = Astro.props;
// Site-level navigation only. Proposal section links belong inside that page.
---

<header class="site-header">
  <div class="container header-inner">
    <a class="site-name" href="/">
      <img class="site-icon" src={SITE_ICONS.svg} alt="" width="28" height="28" aria-hidden="true" />
      <span>{SITE_NAME}</span>
    </a>
    <nav aria-label="사이트 메뉴">
      <ul class="site-menu">
        {SITE_PAGES.map((page) => (
          <li>
            <a href={page.href} aria-current={activePage === page.id ? 'page' : undefined}>
              {page.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
