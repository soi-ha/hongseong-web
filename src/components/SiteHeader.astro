---
import { SITE_NAME, SITE_PAGES, SITE_ICONS, type SitePage } from '../config/site';
import deck from '../content/proposal-slides.json';

interface Props {
  activePage?: SitePage;
}

const { activePage } = Astro.props;
const downloadSize = `${(deck.download.bytes / 1_000_000).toFixed(1)} MB`;
// Site navigation and the shared PDF download; section navigation stays in the body.
---

<header class="site-header">
  <div class="container header-inner">
    <a class="site-name" href="/">
      <img class="site-icon" src={SITE_ICONS.svg} alt="" width="28" height="28" aria-hidden="true" />
      <span>{SITE_NAME}</span>
    </a>
    <nav aria-label="사이트 메뉴">
      <ul class="site-menu">
        {SITE_PAGES.map((page) => (
          <li>
            <a href={page.href} aria-current={activePage === page.id ? 'page' : undefined}>
              {page.label}
            </a>
          </li>
        ))}
        <li>
          <a class="header-download" id="pdf-download" data-theme="dark" href={deck.download.src} download={deck.download.filename} type="application/pdf" aria-label={`PDF 다운로드 · ${deck.pageCount}쪽 · ${downloadSize}`} title={deck.download.filename}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" /></svg>
            <span>PDF 다운로드</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
