---
import SiteHeader from '../components/SiteHeader.astro';
import { SITE_NAME, SITE_ICONS, type SitePage } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  browserTitle?: string;
  description: string;
  activePage: SitePage;
  customHeading?: boolean;
  mainClass?: string;
}

const { title, browserTitle = title, description, activePage, customHeading = false, mainClass } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="application-name" content={SITE_NAME} />
    <link rel="preload" href="/fonts/A2Z-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={SITE_ICONS.ico} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={SITE_ICONS.svg} type="image/svg+xml" sizes="any" />
    <title>{browserTitle} | {SITE_NAME}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 이동</a>
    <SiteHeader activePage={activePage} />
    <main id="main-content" class:list={['main-content', mainClass, { container: !customHeading, 'proposal-main': customHeading && activePage === 'proposal' }]} tabindex="-1">
      {!customHeading && <h1>{title}</h1>}
      <slot name="page-navigation" />
      <slot />
    </main>
  </body>
</html>
