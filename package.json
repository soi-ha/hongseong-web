{
  "name": "hongseong-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.9.0",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "preview:workers": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "deploy:check": "npm run build && npm run check:content && wrangler deploy --dry-run",
    "deploy": "npm run check && npm run build && npm run check:content && wrangler deploy",
    "check:content": "node scripts/verify-proposal.mjs && npm run check:site",
    "check:site": "node scripts/verify-site.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
