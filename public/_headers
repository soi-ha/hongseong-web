/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# Astro includes content hashes in these filenames; updated builds get new URLs.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts, photos and slides retain the default revalidation policy because
# their filenames stay the same when reviewed source assets are replaced.
